# Copy to .env.staging ON THE SERVER and fill in real values.
# This file is gitignored (see .gitignore's `.env.*` rule) — never commit
# the real .env.staging.

POSTGRES_USER=bueza_staging
POSTGRES_PASSWORD=changeme-generate-a-real-random-password
POSTGRES_DB=bueza_pets_staging

# Leave false until staging.app.bueza.in / staging.api.bueza.in are
# confirmed serving HTTPS.
COOKIE_SECURE=false
