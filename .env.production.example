# Copy to .env.production ON THE SERVER and fill in real values.
# This file is gitignored (see .gitignore's `.env.*` rule) — never commit
# the real .env.production.

POSTGRES_USER=bueza_prod
POSTGRES_PASSWORD=changeme-generate-a-real-random-password
POSTGRES_DB=bueza_pets_prod

# Leave false until app.bueza.in / api.bueza.in are confirmed serving HTTPS
# (see the SSL setup phase) — a Secure cookie set over plain HTTP is
# silently dropped by browsers, which breaks login.
COOKIE_SECURE=false
